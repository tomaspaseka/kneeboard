<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Signing.props" Condition="Exists('$(MSBuildProjectDirectory)\Signing.props')" />
  <!-- Optional machine-local build overrides (gitignored). Set <IncludeAndroid>false</IncludeAndroid>
       here to build Windows-only on a machine that doesn't have the .NET Android workload installed. -->
  <Import Project="Build.local.props" Condition="Exists('$(MSBuildProjectDirectory)\Build.local.props')" />
  <PropertyGroup>
    <!-- Android is included by default so CI and Android-equipped machines are unaffected.
         Set IncludeAndroid=false (e.g. in Build.local.props) to drop the Android target where
         the Android workload isn't installed. -->
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IncludeAndroid)' != 'false'">net10.0-android;$(TargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Kneeboard</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Display name -->
    <ApplicationTitle>Kneeboard</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.tpaseka.kneeboard</ApplicationId>
    <ApplicationIdGuid>66b6e3b3-f361-480f-aa07-c2eaae7ed48b</ApplicationIdGuid>
    <!-- Versions: MAJOR.MINOR.REVISION — Publish-Release.ps1 auto-bumps REVISION each release.
             Bump MAJOR or MINOR manually in this file when warranted; reset REVISION to 0.
             ApplicationVersion must equal the REVISION number (4th MSIX Identity component). -->
    <ApplicationDisplayVersion>1.9.0</ApplicationDisplayVersion>
    <ApplicationVersion>0</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- Keep the auto-generated module initializer disabled so it doesn't fire when
             Kneeboard.dll is loaded by the test runner. Bootstrap.Initialize() is called
             explicitly in Platforms/Windows/Program.cs instead (runs only on EXE startup). -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Suppress the auto-generated Program.Main so we can provide our own that calls
             Bootstrap.Initialize() before Application.Start(). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#10243D" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\appiconfg.svg" Color="#10243D" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Embedded rather than a MauiAsset so SectionSource resolves it identically in the app package
         and in the test project, which sets UseMaui=false and runs outside MSIX. -->
    <EmbeddedResource Include="Assets\page-render-failed.png" LogicalName="Kneeboard.Assets.page-render-failed.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.60" />
  </ItemGroup>
</Project>